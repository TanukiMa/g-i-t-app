# Copy to .env and fill in. .env is ignored by git and docker (see .gitignore, .dockerignore).
#   cp .env.sample .env
#   wslc run --rm --env-file .env g-i-t-app            (or: docker run --rm --env-file .env g-i-t-app)
#
# --env-file format: KEY=value, one per line. Quotes are NOT removed (write abc, not "abc"),
# there is no "export", and a "#" only starts a comment at the beginning of a line.
# In Cloud Run these are not read from a file: use --set-env-vars / --set-secrets (docs/cloud-run.md).

# ---- stalk (default command) : required ----
# Token that can read and write contents of the data repository (fine-grained, Contents: Read and write)
GH_PAT=
SUPABASE_URL=https://<project-ref>.supabase.co
# Secret key (sb_secret_...), server side only
SUPABASE_KEY=
# Contact address sent as the HTTP From header to the checked sites (must contain "@" and ".")
WEBSITE_STALKER_FROM=
# Public URL of the dashboard (with trailing slash; used for the Atom feeds)
SITE_BASE_URL=https://git.example.com/
# Where to publish, comma separated (default github-pages = gh-pages branch of the data repository):
#   github-pages | firebase | cloudflare-pages      e.g. DEPLOY_TARGETS=firebase,cloudflare-pages
# Every target is deployed independently; one failing does not stop the others.
DEPLOY_TARGETS=github-pages
# firebase: needed when DEPLOY_TARGETS contains firebase
FIREBASE_PROJECT=
# cloudflare-pages: needed when DEPLOY_TARGETS contains cloudflare-pages (token: Pages edit permission only)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=

# ---- stalk : AI summaries ----
GEMINI_API_KEY=
# Optional: models in order of preference (default gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite)
#GEMINI_MODELS=
# Optional: second provider with an OpenAI-compatible chat API, used when every Gemini model failed
#LLM_FALLBACK_URL=
#LLM_FALLBACK_MODEL=
#LLM_FALLBACK_KEY=
# Optional: failed summaries retried per run (default 10, 0 = off)
#SUMMARY_BACKFILL_LIMIT=10

# ---- stalk : time limits and parallelism (defaults shown; usually no need to change them) ----
#STALK_BUDGET_MIN=40       # whole run: no new site in the last 12 min, no new summary in the last 8 (the workflow limit is 60)
#SUMMARY_WORKERS=4         # AI summaries made at the same time
#GEMINI_TIMEOUT_SEC=60     # one request to Gemini
#SUMMARY_MAX_SEC=180       # all attempts (models, retries) for one summary

# ---- stalk : optional ----
# Data repository (default TanukiMa/g-i-t-data). For a local test use a COPY: the run pushes to it.
#DATA_REPO=TanukiMa/g-i-t-data
# Application code fetched at start (default TanukiMa/g-i-t-app, ref main; a branch, tag or commit SHA)
#APP_REPO=TanukiMa/g-i-t-app
#APP_REF=main

# ---- stalk : the installable app (PWA) ----
# 0 = switched off: no manifest, no install button or hint, and /sw.js becomes a worker that removes an app that was
# installed earlier. Default (variable not set) = on. Change it back to 1 to offer the app again.
PWA_ENABLED=0

# ---- stalk : access analytics (optional, readers can opt out; see privacy.html) ----
# Empty = that service is switched off; with both empty no tag is added to the pages.
# Google Analytics 4 measurement ID (G-XXXXXXXXXX)
GA_MEASUREMENT_ID=
# Cloudflare Web Analytics token (the "token" value of the data-cf-beacon snippet)
CF_BEACON_TOKEN=

# ---- archive command (wslc run --rm --env-file .env g-i-t-app archive) ----
# SUPABASE_URL and SUPABASE_KEY from above, plus the Internet Archive S3 keys:
IA_ACCESS_KEY=
IA_SECRET_KEY=
#ARCHIVE_BATCH_SIZE=20
#ARCHIVE_INTERVAL_SEC=15
#ARCHIVE_RUNTIME_MIN=14
# After the S3-key rate limit: go on without keys at this slower pace (seconds), retry the keys after N minutes.
# ARCHIVE_ANON_FALLBACK=0 turns the unauthenticated mode off (stop at the first rate limit).
#ARCHIVE_ANON_FALLBACK=1
#ARCHIVE_ANON_INTERVAL_SEC=60
#ARCHIVE_AUTH_RETRY_MIN=15

# ---- raw command (wslc run --rm --env-file .env g-i-t-app raw): editor experiment, see AGENTS.md section 9 ----
# GH_PAT and WEBSITE_STALKER_FROM from above (GH_PAT must also be allowed to write to the raw repository).
# Normally 0 (off): the raw arm fetches every site a second time, which is extra load on the monitored sites.
# Set 1 only while the experiment runs (about a month); 1 = fetch every site WITHOUT editors into g-i-t-data-raw.
RAW_EXPERIMENT=0
#RAW_REPO=TanukiMa/g-i-t-data-raw
#RAW_WORKERS=4             # sites fetched at the same time
#RAW_BUDGET_MIN=40         # no new site is fetched after this many minutes
