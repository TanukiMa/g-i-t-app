# Copy to .env and fill in. .env is ignored by git and docker (see .gitignore, .dockerignore).
#   cp .env.sample .env
#   wslc run --rm --env-file .env g-i-t-app            (or: docker run --rm --env-file .env g-i-t-app)
#
# --env-file format: KEY=value, one per line. Quotes are NOT removed (write abc, not "abc"),
# there is no "export", and a "#" only starts a comment at the beginning of a line.
# In Cloud Run these are not read from a file: use --set-env-vars / --set-secrets (docs/cloud-run.md).

# ---- stalk (default command) : required ----
# Token that can read and write contents of the data repository (fine-grained, Contents: Read and write)
GH_PAT=
SUPABASE_URL=https://<project-ref>.supabase.co
# Secret key (sb_secret_...), server side only
SUPABASE_KEY=
# Contact address sent as the HTTP From header to the checked sites (must contain "@" and ".")
WEBSITE_STALKER_FROM=
# Firebase project and public URL of the dashboard (with trailing slash; used for the Atom feeds)
FIREBASE_PROJECT=
SITE_BASE_URL=https://git.example.com/

# ---- stalk : AI summaries ----
GEMINI_API_KEY=
# Optional: models in order of preference (default gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite)
#GEMINI_MODELS=
# Optional: second provider with an OpenAI-compatible chat API, used when every Gemini model failed
#LLM_FALLBACK_URL=
#LLM_FALLBACK_MODEL=
#LLM_FALLBACK_KEY=
# Optional: failed summaries retried per run (default 10, 0 = off)
#SUMMARY_BACKFILL_LIMIT=10

# ---- stalk : optional ----
# Data repository (default TanukiMa/g-i-t-data). For a local test use a COPY: the run pushes to it.
#DATA_REPO=TanukiMa/g-i-t-data
# Application code fetched at start (default TanukiMa/g-i-t-app, ref main; a branch, tag or commit SHA)
#APP_REPO=TanukiMa/g-i-t-app
#APP_REF=main

# ---- stalk : access analytics (optional, readers can opt out; see privacy.html) ----
# Empty = that service is switched off; with both empty no tag is added to the pages.
# Google Analytics 4 measurement ID (G-XXXXXXXXXX)
GA_MEASUREMENT_ID=
# Cloudflare Web Analytics token (the "token" value of the data-cf-beacon snippet)
CF_BEACON_TOKEN=

# ---- archive command (wslc run --rm --env-file .env g-i-t-app archive) ----
# SUPABASE_URL and SUPABASE_KEY from above, plus the Internet Archive S3 keys:
IA_ACCESS_KEY=
IA_SECRET_KEY=
#ARCHIVE_BATCH_SIZE=20
#ARCHIVE_INTERVAL_SEC=15
#ARCHIVE_RUNTIME_MIN=14
